#!/bin/sh
# Bloqueia commit com segredo (chave de API, token) ou com arquivo .env (RS-08).
# Ativar uma vez por clone: git config core.hooksPath .githooks
set -e

if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' >/dev/null; then
  echo "pre-commit: há um arquivo .env no commit. Segredo fica fora do git (RS-08)." >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks não encontrado. Sem ele, o commit não passa: https://github.com/gitleaks/gitleaks" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner
